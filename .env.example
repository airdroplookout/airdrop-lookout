# Copy to .env (local) and to Netlify → Site settings → Environment variables (production).
# NEVER commit a filled-in .env. Real secrets go in dashboards only.
# Domain is a placeholder — change it in ONE place: public/config.js (SITE_DOMAIN)
# and in the settings table (site_domain). Do not buy a domain until Adil confirms the spelling.

# Supabase — Dashboard → Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # SERVER ONLY. Never in the browser. Used by Functions.

# Brevo — Dashboard → SMTP & API → API Keys (v3)
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=news@airdroplookout.com
BREVO_SENDER_NAME=Airdrop Lookout

# Admin API — Dexter (Muse) weekly auto-send + Manage login
# Generate a long random value, e.g. `openssl rand -hex 32`.
# Keep one copy in Netlify environment variables and one in the Muse scheduled job.
# Rotate by changing it in both places; old keys stop working immediately.
ADMIN_API_KEY=CHANGE-ME-TO-A-LONG-RANDOM-VALUE

# Site — single config value. Change here AND in public/config.js.
SITE_DOMAIN=airdroplookout.com
SITE_URL=https://airdroplookout.com
